# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Database
DB_NAME=securevault_db
DB_USER=postgres
DB_PASS=change-me-in-your-local-env
DB_HOST=db
DB_PORT=5432

# Django
DEBUG=True
SECRET_KEY=generate-a-long-random-string-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (console backend for dev — swap for SMTP in prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@securevault.com
FRONTEND_URL=http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_EXTENSIONS=pdf,docx,xlsx,txt,png,jpg,jpeg
