# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# Database
DB_NAME=securevault_db
DB_USER=postgres
DB_PASS=change-me-in-your-local-env
DB_HOST=db
DB_PORT=5432

# Django
DEBUG=True
SECRET_KEY=generate-a-long-random-string-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (console backend for dev — swap for SMTP in prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@securevault.com
FRONTEND_URL=http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_EXTENSIONS=pdf,docx,xlsx,txt,png,jpg,jpeg

# Encryption at rest — 32 url-safe base64 bytes, generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=generate-a-fernet-key-here

# Malware scanning (ClamAV) — leave False to skip scanning (dev/CI without
# a clamd daemon running). Set to True + point to a reachable clamd instance
# to scan uploads before encryption. Fail-closed: enabled + unreachable = 400.
CLAMAV_ENABLED=False
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# Storage — optional. Leave USE_S3=False to keep storing files on local disk
# (default, no AWS account needed). Set to True + fill the AWS_* vars to
# store encrypted blobs on S3 instead — files are still encrypted/decrypted
# by Django (see README "Décision : stockage local + Fernet"), no presigned
# URLs, the client never talks to S3 directly.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-3
